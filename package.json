{
  "name": "@jscpd/fs-extra",
  "version": "0.1.0",
  "description": "fs-extra 11.4.1 API implemented as a native Node.js addon in Rust (napi-rs). Experimental.",
  "keywords": [
    "fs",
    "file",
    "file system",
    "copy",
    "directory",
    "extra",
    "mkdirp",
    "mkdir",
    "mkdirs",
    "recursive",
    "json",
    "read",
    "write",
    "delete",
    "remove",
    "touch",
    "create",
    "text",
    "output",
    "move",
    "promise",
    "native",
    "rust",
    "napi"
  ],
  "author": "Andrey Kucherenko <kucherenko.andrey@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kucherenko/fs-extra-rs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kucherenko/fs-extra-rs.git"
  },
  "bugs": {
    "url": "https://github.com/kucherenko/fs-extra-rs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "main": "./lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/index.js"
    },
    "./esm": "./lib/esm.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "!lib/**/__tests__/",
    "index.d.ts"
  ],
  "napi": {
    "name": "fs-extra",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js false --dts target/napi.d.ts",
    "build:debug": "napi build --platform --js false --dts target/napi.d.ts",
    "lint": "standard lib/index.js lib/native.js lib/native-errors.js \"lib/{copy,empty,ensure,json,mkdirs,move,output-file,path-exists,remove,util,fs}/*.js\" lib/__tests__ bench",
    "unit": "node test.js",
    "unit-esm": "node test.mjs",
    "test": "npm run lint && npm run unit && npm run unit-esm",
    "bench": "node bench/bench.js",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --skip-gh-release"
  },
  "dependencies": {
    "graceful-fs": "^4.2.0",
    "jsonfile": "^6.0.1",
    "universalify": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "klaw": "^2.1.1",
    "klaw-sync": "^3.0.2",
    "minimist": "^1.1.1",
    "mocha": "^10.1.0",
    "nyc": "^15.0.0",
    "read-dir-files": "^0.1.1",
    "rimraf": "^3.0.2",
    "standard": "^17.0.0",
    "typescript": "^7.0.2",
    "@napi-rs/cli": "^2.18.4",
    "fs-extra": "11.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
